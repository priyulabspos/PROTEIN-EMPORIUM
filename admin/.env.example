# ==============================================================================
# PROTEIN EMPORIUM - ADMIN PORTAL & STOREFRONT BACKEND ENVIRONMENT
# ==============================================================================

# Supabase Credentials
# Get these from your Supabase Dashboard: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Admin Authentication & Session
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Razorpay Payments (Test / Live)
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Shipping Carrier (Shiprocket / Delhivery / BlueDart Adapter)
SHIPROCKET_API_USER=shipping@proteinemporium.com
SHIPROCKET_API_PASSWORD=YourShiprocketPassword
SHIPROCKET_API_URL=https://apiv2.shiprocket.in/v1/external

# Communication (Email & SMS & WhatsApp)
RESEND_API_KEY=re_YourResendApiKey
FAST2SMS_API_KEY=YourFast2SmsApiKey
WHATSAPP_BUSINESS_TOKEN=YourWhatsAppCloudApiToken
WHATSAPP_PHONE_NUMBER_ID=YourWhatsAppPhoneNumberId

# Security & Limits
ADMIN_SESSION_MAX_AGE_SECONDS=28800 # 8 Hours
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
